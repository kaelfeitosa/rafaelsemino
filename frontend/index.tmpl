<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rafael Semino | Portfólio</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;700;900&family=Lora:ital,wght@0,400;0,700;1,400&display=swap"
        rel="stylesheet">
    <script src="focus-image.js"></script>
    <style>
        :root {
            --black: #000000;
            --white: #ffffff;
            --red: #e60000;
            --gray: #f2f2f2;
            --border: #000;
            --text-light: #ddd;
            --ease: cubic-bezier(0.23, 1, 0.32, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--white);
            color: var(--black);
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            overflow-x: hidden;
        }

        /* GRAIN OVERLAY */
        .noise {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0.15;
            z-index: 9999;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* PRINT SETTINGS - Optimized for A4 pragmatic printing */
        @media print {
            :root {
                --black: #000;
                --white: #fff;
                --red: #e60000;
            }

            .no-print,
            header:not(.print-header),
            .noise,
            .btn-work,
            .hero-overlay,
            .hero-header-info:not(.contact-info-print) {
                display: none !important;
            }

            body {
                background: white !important;
                color: black !important;
                padding: 0 !important;
                margin: 0 !important;
                font-size: 11pt !important;
                text-shadow: none !important;
                -webkit-text-stroke: 0 !important;
            }

            * {
                text-shadow: none !important;
                -webkit-text-stroke: 0 !important;
            }

            .page-wrapper {
                max-width: none !important;
                border: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            section {
                page-break-before: always;
                border: none !important;
                padding: 10mm 0 !important;
                display: block !important;
                opacity: 1 !important;
                transform: none !important;
            }

            section:first-of-type {
                page-break-before: avoid;
            }

            .section-label {
                position: static !important;
                writing-mode: horizontal-tb !important;
                transform: none !important;
                font-size: 24pt !important;
                color: black !important;
                -webkit-text-stroke: 0 !important;
                text-shadow: none !important;
                margin: 0 0 10mm 0 !important;
                /* Reset layout to avoid cut-off */
                width: 100% !important;
                padding: 0 0 5mm 0 !important;
                border-bottom: 2pt solid var(--red) !important;
                display: block !important;
                text-align: left !important;
            }

            .card {
                break-inside: avoid;
                border: 1pt solid #000 !important;
                background: white !important;
                color: black !important;
                box-shadow: none !important;
                margin-bottom: 5mm;
            }

            .card--light {
                background: white !important;
            }

            .card-img {
                height: 200px !important;
                /* Cap height to save space/ink */
                border-bottom: 1pt solid #000 !important;
            }

            .card-img focus-image {
                filter: grayscale(100%) brightness(1.1) !important;
            }

            .card-content {
                padding: 5mm !important;
            }

            .card p,
            .card li,
            .profile-text p {
                color: black !important;
                font-size: 10pt !important;
            }

            .hero--index {
                height: auto !important;
                min-height: auto !important;
                background: white !important;
                color: black !important;
                border-bottom: 3pt solid black !important;
                display: block !important;
                padding: 10mm !important;
            }

            .hero-title {
                color: black !important;
                font-size: 48pt !important;
                line-height: 0.9 !important;
            }

            .hero-title span {
                color: var(--red) !important;
            }

            .hero-bio--floating {
                background: transparent !important;
                border-left: 5pt solid var(--red) !important;
                padding: 5mm 10mm !important;
                backdrop-filter: none !important;
                margin-top: 10mm !important;
            }

            .hero-bio--floating p {
                color: black !important;
                font-size: 14pt !important;
            }

            .section-header,
            .section-subtitle,
            .course-institution,
            .atuacao-group p.group-label {
                break-after: avoid !important;
            }

            .card--red-shadow {
                background: white !important;
                border: 1pt solid var(--red) !important;
                color: black !important;
                box-shadow: none !important;
            }

            .card--red-shadow h3 {
                color: var(--red) !important;
            }

            .card--red-shadow p,
            .card--red-shadow li {
                color: black !important;
            }

            .catalog-grid,
            .atuacao-consolidated-grid {
                display: block !important;
            }

            /* Optimized lists for print space */
            .hyphen-list,
            .eixos-list,
            .awards-list {
                column-count: 2;
                column-gap: 10mm;
            }

            .atuacao-consolidated-grid {
                column-count: 3;
                column-gap: 5mm;
            }

            .atuacao-group {
                margin-bottom: 5mm;
                break-inside: avoid;
            }

            .main-footer {
                border-top: 2pt solid black !important;
                background: white !important;
                color: black !important;
                padding: 10mm !important;
                page-break-before: auto;
            }

            .big-link {
                font-size: 20pt !important;
                color: black !important;
                text-shadow: none !important;
                transform: none !important;
            }

            a[href^="http"]:after {
                content: " [" attr(href) "]";
                font-size: 8pt;
                color: #666;
                font-weight: normal;
                text-transform: none;
            }

            .print-header {
                display: flex !important;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1pt solid #eee;
                padding-bottom: 2mm;
                margin-bottom: 5mm;
                font-size: 9pt;
                text-transform: uppercase;
                letter-spacing: 1px;
            }
        }

        /* Layout */
        .page-wrapper {
            max-width: 1440px;
            margin: 0 auto;
            border-left: 2px solid var(--border);
            border-right: 2px solid var(--border);
            position: relative;
        }

        header {
            padding: 40px;
            border-bottom: 6px solid var(--black);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            position: sticky;
            top: 0;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }

        .brand h1 {
            font-family: 'Archivo Black', sans-serif;
            font-size: 3.5rem;
            line-height: 0.8;
            letter-spacing: -3px;
        }

        .brand p {
            font-size: 0.85rem;
            font-weight: 900;
            text-transform: uppercase;
            color: var(--red);
            margin-top: 8px;
            letter-spacing: 2px;
        }

        .nav-meta {
            text-align: right;
            font-size: 0.75rem;
            text-transform: uppercase;
            font-weight: 800;
            letter-spacing: 1px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

        .btn-print {
            background: var(--red);
            color: white;
            border: none;
            padding: 8px 16px;
            font-family: 'Archivo Black', sans-serif;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-print:hover {
            background: var(--black);
            transform: translateY(-2px);
            box-shadow: 4px 4px 0 var(--red);
        }

        .nav-meta span {
            display: inline-block;
            margin-left: 20px;
        }

        .print-header {
            display: none;
        }

        .meta-contact {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-align: right;
        }

        /* Section Styling */
        section {
            padding: 120px 60px;
            border-bottom: 2px solid var(--border);
            display: grid;
            grid-template-columns: 180px 1fr;
            gap: 60px;
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s var(--ease);
            align-items: start;
        }

        section.visible {
            opacity: 1;
            transform: none;
        }

        .section-label {
            font-family: 'Archivo Black', sans-serif;
            font-size: 5rem;
            line-height: 0.8;
            color: var(--black);
            position: sticky;
            top: 40px;
            height: auto;
            text-transform: uppercase;
            transition: all 0.4s var(--ease);
            cursor: default;
            -webkit-text-stroke: 1px var(--black);
            z-index: 10;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
            padding-bottom: 40px;
            pointer-events: none;
        }

        /* Catalog Grid */
        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 60px;
        }

        .card {
            border: 2px solid var(--black);
            background: var(--black);
            color: var(--white);
            transition: all 0.5s var(--ease);
            position: relative;
        }

        .card:hover {
            border-color: var(--red);
            box-shadow: 15px 15px 0px var(--red);
            transform: translate(-5px, -5px);
        }

        .card-img {
            width: 100%;
            height: 640px;
            background: var(--gray);
            overflow: hidden;
            position: relative;
            border-bottom: 2px solid var(--black);
        }

        .card-img focus-image {
            width: 100%;
            height: 100%;
            /* fit="cover" is default in component */
            filter: grayscale(100%) contrast(1.1);
            transition: all 0.6s var(--ease);
        }

        .card:hover .card-img focus-image {
            filter: grayscale(0) contrast(1);
            transform: scale(1.05);
        }

        .card-content {
            padding: 40px;
        }

        .card-tag {
            font-size: 0.7rem;
            font-weight: 900;
            text-transform: uppercase;
            color: var(--red);
            margin-bottom: 15px;
            display: inline-block;
            border-bottom: 1px solid var(--red);
            transition: all 0.3s;
        }

        .card:hover .card-tag {
            background: var(--red);
            color: white;
            padding: 2px 6px;
            transform: skew(-10deg);
        }

        .card h3 {
            font-family: 'Archivo Black', sans-serif;
            font-size: 1.8rem;
            margin-bottom: 20px;
            text-transform: uppercase;
            line-height: 1;
        }

        /* Legibility Fix: Ensure color is set per card theme */
        .card p {
            font-family: 'Lora', serif;
            font-size: 1.1rem;
            color: var(--text-light);
            /* Default for black cards */
        }

        .card.card--light p {
            color: var(--black);
        }

        .card-footer {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px dashed #444;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #888;
        }

        /* Hero Section */
        .hero {
            background: var(--black);
            color: var(--white);
            padding: 160px 60px;
            grid-template-columns: 1fr 1fr;
            border-bottom: none;
            opacity: 1;
            transform: none;
        }

        .hero--index {
            background: url('images/optimized/agent-rafael-semino-001.webp') center/cover no-repeat;
            height: 85vh;
            max-height: 1080px;
            position: relative;
            border-bottom: 10px solid var(--black);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 0;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.2) 100%);
        }

        .hero-header-info {
            position: absolute;
            top: 40px;
            right: 40px;
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 1;
            padding: 40px 60px;
        }

        .hero-tag {
            color: var(--red);
            font-family: 'Archivo Black', sans-serif;
            font-size: 1rem;
            letter-spacing: 5px;
            margin-bottom: 10px;
        }

        .hero-title {
            font-size: 12vw;
            color: white;
            line-height: 0.85;
        }

        .hero-bio--floating {
            border-left: 10px solid var(--red);
            padding: 15px 30px;
            margin-top: 30px;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(5px);
            max-width: 700px;
        }

        .hero-bio--floating p {
            font-size: 2rem;
            font-weight: 900;
            line-height: 1.1;
            color: white;
            margin-bottom: 0;
        }

        .hero-text h2 {
            font-family: 'Archivo Black', sans-serif;
            font-size: 9.5vw;
            line-height: 0.8;
            margin-bottom: 40px;
            letter-spacing: -5px;
            transition: all 0.5s var(--ease);
        }

        .hero-text h2:hover {
            text-shadow: 15px 15px 0px var(--red);
            transform: translate(-8px, -8px);
        }

        .hero-text h2:hover span {
            color: var(--white);
        }

        .hero-text span {
            color: var(--red);
        }

        .hero-bio {
            font-family: 'Lora', serif;
            font-size: 1.6rem;
            line-height: 1.4;
            border-left: 6px solid var(--red);
            padding-left: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .hero-bio p {
            margin-bottom: 30px;
        }

        /* Footer */
        footer {
            padding: 140px 60px;
            text-align: center;
            background: var(--black);
            color: white;
        }

        .big-link {
            font-family: 'Archivo Black', sans-serif;
            font-size: clamp(3rem, 12vw, 10rem);
            color: var(--white);
            text-decoration: none;
            line-height: 0.9;
            transition: all 0.3s;
            display: block;
        }

        .big-link:hover {
            color: var(--white);
            text-shadow: 15px 15px 0px var(--red);
            transform: translate(-8px, -8px);
            -webkit-text-stroke: 0;
        }

        /* QR CODE SIMULATION */
        .qr-placeholder {
            width: 80px;
            height: 80px;
            background: white;
            padding: 5px;
            display: none;
            margin: 20px auto 0;
        }

        @media print {
            .qr-placeholder {
                display: block;
                border: 1px solid #000;
            }
        }

        /* Responsive */
        @media (max-width: 1200px) {
            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
                padding: 30px 40px;
                position: static;
                /* Prevent overlap with sticky section labels on mobile */
            }

            .nav-meta {
                text-align: left;
            }

            section {
                grid-template-columns: 1fr;
                gap: 40px;
                padding: 80px 40px;
            }

            .section-label {
                font-size: 10vw;
                position: sticky;
                top: 0;
                width: calc(100% + 80px);
                /* Account for section padding */
                margin: -80px -40px 40px -40px;
                padding: 20px;
                height: auto;
                writing-mode: horizontal-tb;
                transform: none;
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(10px);
                border-bottom: 4px solid var(--black);
                display: flex;
                justify-content: center;
                align-items: center;
                z-index: 50;
                pointer-events: auto;
                letter-spacing: -2px;
            }

            .hero {
                grid-template-columns: 1fr;
                padding: 100px 40px;
            }

            .hero-text h2 {
                font-size: 18vw;
            }
        }

        @media (max-width: 768px) {
            .brand h1 {
                font-size: 12vw;
            }

            .catalog-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }
        }

        /* WOODCUT UTILS */
        .woodcut-border {
            border: 4px solid var(--black);
            box-shadow: 8px 8px 0px var(--black);
        }

        .stamped {
            text-shadow: 3px 3px 0px rgba(0, 0, 0, 0.2);
            -webkit-text-stroke: 1px var(--black);
        }

        .img-stack {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 2px;
            background: var(--black);
            border: 4px solid var(--black);
        }

        .img-stack focus-image {
            width: 100%;
            height: 400px;
            /* fit="cover" default */
            filter: grayscale(1) contrast(1.2);

        }

        .img-stack focus-image:hover {
            filter: grayscale(0) contrast(1);
        }

        /* CAROUSEL STYLES */
        .carousel-container {
            position: relative;
            width: 100%;
            height: 400px;
            background: var(--black);
            overflow: hidden;
            border: 4px solid var(--black);
        }

        .carousel-wrapper {
            display: flex;
            gap: 2px;
            width: 100%;
            height: 100%;
            transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .carousel-slide {
            flex: 0 0 100%;
            height: 100%;
        }

        .carousel-container--cols-2 .carousel-slide {
            flex: 0 0 calc((100% - 2px) / 2);
        }

        .carousel-container--cols-3 .carousel-slide {
            flex: 0 0 calc((100% - 4px) / 3);
        }

        .carousel-slide focus-image {
            width: 100%;
            height: 100%;
            /* fit="cover" default */
            filter: grayscale(1) contrast(1.2);
            transition: filter 0.3s;
        }

        .carousel-slide focus-image:hover {
            filter: grayscale(0) contrast(1);
        }

        /* Carousel Navigation Buttons */
        .carousel-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: var(--red);
            color: white;
            border: 2px solid var(--black);
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Archivo Black', sans-serif;
            font-size: 1.2rem;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s;
            box-shadow: 4px 4px 0 var(--black);
        }

        .carousel-btn:hover {
            background: var(--white);
            color: var(--red);
            transform: translateY(-50%) translate(-2px, -2px);
            box-shadow: 6px 6px 0 var(--black);
        }

        .carousel-btn--prev {
            left: 15px;
        }

        .carousel-btn--next {
            right: 15px;
        }

        /* Carousel Indicators */
        .carousel-indicators {
            position: absolute;
            bottom: 15px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 10;
        }

        .carousel-dot {
            width: 12px;
            height: 12px;
            background: var(--white);
            border: 2px solid var(--black);
            border-radius: 0;
            cursor: pointer;
            transition: all 0.3s;
        }

        .carousel-dot.active {
            background: var(--red);
            transform: scale(1.2) rotate(45deg);
        }

        .card--light {
            background: var(--white);
            color: var(--black);
        }

        .project-details-divider {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px dashed var(--black);
        }

        .project-details-divider p {
            font-family: 'Lora', serif;
            font-size: 1.2rem;
        }



        .flex-col-gap {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .section-header {
            font-family: 'Archivo Black', sans-serif;
            font-size: 2.5rem;
            text-transform: uppercase;
        }

        .section-header.mt-20 {
            margin-top: 20px;
        }

        .project-title {
            font-size: 2.5rem;
            margin-top: 10px;
        }

        .project-desc {
            font-family: 'Lora', serif;
            font-size: 1.2rem;
            margin-top: 20px;
        }

        .project-desc.light {
            color: var(--text-light);
        }

        .project-meta {
            margin-top: 20px;
        }

        .project-meta.light {
            color: var(--text-light);
        }





        .awards-list {
            font-family: 'Archivo Black', sans-serif;
            font-size: 2rem;
            line-height: 1.4;
            text-transform: uppercase;
        }

        .awards-list li {
            margin-bottom: 30px;
        }

        .award-sub {
            font-family: 'Lora', serif;
            font-size: 1.2rem;
            text-transform: none;
            margin-top: 5px;
            opacity: 0.9;
        }

        .eixos-list {
            font-family: 'Archivo Black', sans-serif;
            font-size: 2.2rem;
            line-height: 1.4;
            text-transform: uppercase;
        }

        .direction-list {
            font-size: 1.1rem;
            margin-top: 15px;
        }

        .project-meta p+p {
            margin-top: 10px;
        }

        .course-institution {
            margin-top: 10px;
            font-size: 2rem;
        }

        .course-details {
            margin-top: 15px;
        }

        .course-details+.course-details {
            margin-top: 10px;
        }

        .card-tag.card-tag--red {
            background: var(--red);
            color: white;
        }

        .av-title {
            font-size: 2.5rem;
            margin-top: 20px;
        }

        .av-project-box {
            margin-top: 30px;
        }

        .av-project-title {
            font-family: 'Archivo Black', sans-serif;
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        .section-header--on-red {
            margin-bottom: 40px;
            color: white;
        }

        .av-project-desc {
            font-family: 'Lora', serif;
            font-size: 1.2rem;
        }




        /* Shared list style properties */
        .hyphen-list li::before,
        .awards-list li::before,
        .eixos-list li::before,
        .direction-list li::before {
            margin-right: 0.5em;
        }

        .hyphen-list li::before {
            content: "- ";
        }

        .awards-list li::before,
        .eixos-list li::before,
        .direction-list li::before {
            content: "• ";
        }



        .card--red-shadow {
            background: var(--red);
